# Normalize text files to LF in the repo, check out per platform defaults
* text=auto eol=crlf

# Batch files must be CRLF
*.bat text eol=crlf

# Source and docs stored with LF
*.cs   text eol=lf
*.py   text eol=lf
*.ps1  text eol=crlf
*.json text eol=lf
*.md   text eol=lf
*.manifest text eol=crlf

# Never touch binaries
*.exe binary
*.dll binary
